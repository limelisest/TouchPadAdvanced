<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputPath>bin/core/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Native.cs;Frames.cs;HidDescriptor.cs;RawInputSource.cs;Diagnostics.cs;GestureSettings.cs;EdgeGestureEngine.cs;GestureActions.cs;GestureRuntime.cs;MouseInputHook.cs;PointerCaptureController.cs;GestureInputHost.cs;StartupRegistration.cs;GestureActionExecutor.cs"/>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>TouchPadAdvanced.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>TouchPadAdvanced</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
