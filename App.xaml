<Application
    x:Class="TouchPadAdvanced.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="EdgeResizeThumbStyle" TargetType="primitives:Thumb">
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                <Setter Property="IsTabStop" Value="True"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="primitives:Thumb">
                            <Grid Background="Transparent">
                                <Border Background="{TemplateBinding Background}" CornerRadius="3" Margin="4"
                                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

